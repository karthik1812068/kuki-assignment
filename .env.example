# Local development defaults. Copy to .env. Never commit .env.
NODE_ENV=development
LOG_LEVEL=info

# Required to boot the API and agent worker.
# If 5432 or 6379 is already in use, set POSTGRES_PORT and REDIS_PORT
# before docker compose, and point these URLs at the same host ports.
# POSTGRES_PORT=5432
# REDIS_PORT=6379
DATABASE_URL=postgresql://codepilot:codepilot@localhost:5432/codepilot
REDIS_URL=redis://localhost:6379
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Reserved for later phases. Leave unset until those phases need them.
# GitHub OAuth. All three plus ENCRYPTION_KEY are required before sign-in works.
# Create an OAuth app whose callback is the API URL below.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/auth/github/callback

# Model access. A completion is possible only when both the key and LLM_MODEL are set.
# LLM_BASE_URL defaults to https://api.openai.com/v1. http is allowed only for localhost.
LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=https://api.openai.com/v1
# Optional prices. Cost stays unset until both are present.
# LLM_INPUT_USD_PER_MILLION=
# LLM_OUTPUT_USD_PER_MILLION=
# AGENT_REPAIR_LIMIT=3
# AGENT_TOKEN_BUDGET=20000
# TASK_RATE_LIMIT=20
# SANDBOX_IMAGE=node:22-bookworm-slim

# Optional absolute directory for cloned repositories. Defaults to data/repositories.
# REPOSITORIES_DIR=
# ENCRYPTION_KEY protects the GitHub access token at rest. Minimum 32 characters.
# JWT_SECRET is unused. Sessions are random ids stored in Postgres.
JWT_SECRET=
ENCRYPTION_KEY=
